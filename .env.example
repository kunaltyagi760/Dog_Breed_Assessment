# Dog API base url (no key needed)
EXPO_PUBLIC_API_BASE_URL=https://dogapi.dog/api/v2

# Breeds requested per page; 48 gives the 6 pages the brief describes
EXPO_PUBLIC_PAGE_SIZE=48

# Data older than this is re-synced when the app opens, the network returns, or the app comes back to the foreground
EXPO_PUBLIC_STALE_AFTER_HOURS=6

# Disk budget for cached medium/large images (thumbnails are always kept)
EXPO_PUBLIC_IMAGE_CACHE_MB=100
